---
const { tutor } = Astro.props;
const fmt = (n) => `$${n}`;
const openDays = Object.entries(tutor.availability || {})
  .filter(([, slots]) => slots && slots.length > 0)
  .map(([day]) => day);
---
<article class="card tutor-card" data-super={tutor.isSuperTutor ? 'true' : 'false'} data-days={openDays.join(' ')}>
  <div class="tutor-top">
    <div class="avatar avatar-card" style={`background:${tutor.avatarColor}`} aria-hidden="true">{tutor.initials}</div>
    <div class="tutor-head">
      <h3 style="margin:0"><a href={`/tutors/${tutor.slug}`}>{tutor.name}</a></h3>
      <p class="meta" style="margin:2px 0">{tutor.language} tutor · From {tutor.country}</p>
      <p style="margin:2px 0"><span class="stars">★ {tutor.rating}</span> <span class="meta">({tutor.reviewCount} sample reviews)</span></p>
      <p style="margin:4px 0">{tutor.isSuperTutor && <span class="badge">Super tutor</span>} {tutor.isProfessional && <span class="badge badge-green">Professional</span>} <span class="badge badge-grey">Demo profile</span></p>
    </div>
  </div>
  <p class="next-chip">Next available: <strong>{tutor.nextAvailable}</strong> · Replies {tutor.responseTime}</p>
  <div class="chips">{tutor.specialties.map((s) => <span class="chip">{s}</span>)}</div>
  <p class="meta">Speaks: {tutor.speaks.join(', ')}</p>
  <p class="meta">{tutor.students} students · {tutor.lessons.toLocaleString()} lessons · {tutor.yearsExperience} years’ experience (sample)</p>
  <p class="card-price" style="margin-top:auto"><span class="price">{fmt(tutor.price)} <small>/ 50-min lesson</small></span><br /><span class="meta">Trial: {fmt(tutor.trialPrice)} for 25 min</span></p>
  <p><a class="btn" href={`/tutors/${tutor.slug}`}>View {tutor.name} →</a></p>
</article>
